# ─────────────────────────────────────────────────────────────────────────────
# x402-notify — configuration
# Copy to .env. Every value below has a working default; nothing here is
# required to run the demo.
# ─────────────────────────────────────────────────────────────────────────────

# HTTP port the server listens on.
PORT=4025

# Absolute base URL used in the 402 challenge's "resource" field. Leave unset to
# derive it from the incoming request (right for local dev and most proxies).
# PUBLIC_BASE_URL=https://api.example.com

# ── Payment rail 1: EVM (USDC on Base) ───────────────────────────────────────
# EVM (Base / Base Sepolia) USDC receive address.
PAY_TO_ADDRESS=0x40252CFDF8B20Ed757D61ff157719F33Ec332402
# base-sepolia (testnet, default) or base (mainnet).
NETWORK=base-sepolia
# Facilitator that verifies + settles the EVM rail.
FACILITATOR_URL=https://x402.org/facilitator

# ── Payment rail 2: Solana (USDC SPL) ────────────────────────────────────────
# Solana USDC receive address.
SOLANA_PAY_TO_ADDRESS=WwwuGbqHrwF5RG89KhUbmRWEvjnRH9k5kVM5p7T3WwW
# mainnet-beta (default) or devnet.
SOLANA_NETWORK=mainnet-beta
# Facilitator for the Solana rail. The reference x402.org facilitator only
# settles base-sepolia, so Solana defaults to PayAI's public facilitator.
SOLANA_FACILITATOR_URL=https://facilitator.payai.network
# Public sponsor account that pays the SOL network fee so buyers need only USDC.
# Not a secret and not a payout address — point it at your facilitator's sponsor.
SOLANA_FEE_PAYER=2wKupLR9q6wXYppw8Gr2NvWxKBUqm4PPJKkQfoxHDBg4
# RPC used to build the SPL transfer the buyer signs. The public endpoint is
# heavily rate-limited — use a dedicated RPC (Helius / Triton / QuickNode) in prod.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# SOLANA_DEVNET_RPC_URL=https://api.devnet.solana.com

# ── Live backend (optional) ──────────────────────────────────────────────────
# Unset ⇒ the service answers from a deterministic fixture set and labels every
# response `"source": "fixture"`. Nothing is ever silently faked.

# Telegram bot token — free from @BotFather (/newbot). Unset => POST /telegram is a validated dry run
TELEGRAM_BOT_TOKEN=

# Bot API host — set this to point at a self-hosted Bot API server
TELEGRAM_BASE_URL=https://api.telegram.org

# SMTP server hostname. Unset => POST /email is a validated dry run
SMTP_HOST=

# SMTP port. 587 uses STARTTLS; 465 switches to implicit TLS automatically
SMTP_PORT=587

# SMTP username. Omit (with SMTP_PASS) for an unauthenticated relay
SMTP_USER=

# SMTP password or app password. Never commit a real value
SMTP_PASS=

# Default From address, e.g. "Acme Alerts <alerts@acme.com>". Falls back to SMTP_USER
SMTP_FROM=

# Force implicit TLS: true or false. Leave empty to infer it from SMTP_PORT
SMTP_SECURE=
